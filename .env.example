# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Worker: read-write connection
DATABASE_URL=postgresql://flarewatch:flarewatch@localhost:5432/flarewatch
# Web app: read-only role (flarewatch_web, see db/migrations/003_readonly_role.sql)
DATABASE_URL_READONLY=postgresql://flarewatch:flarewatch@localhost:5432/flarewatch
# west,south,east,north
REGION_BBOX=34,12,63,38
DBSCAN_EPS_M=500
DBSCAN_MIN_SAMPLES=3
SITE_MATCH_RADIUS_M=750
